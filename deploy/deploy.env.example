# 使用 URL 安全的随机密码（字母数字即可），不使用 @ : / # 等连接串保留字符。
POSTGRES_PASSWORD=replace_with_a_long_random_alphanumeric_password
APP_ORIGIN=http://localhost:8080
BIND_ADDR=127.0.0.1
HTTP_PORT=8080
COOKIE_SECURE=false
# openssl rand -hex 32；个人模型密钥加密使用，须和数据库一起备份并保留。
MODEL_ENCRYPTION_KEY=
# 指向真实内网服务器。容器内 127.0.0.1 不是宿主机。
MODEL_BASE_URL=
MODEL_NAME=
MODEL_API_KEY=
