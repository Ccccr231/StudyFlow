{
  "name": "studyflow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1 --port 3000",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "typecheck": "tsc --noEmit",
    "db:setup": "node scripts/init-local.mjs && prisma generate && prisma db push",
    "db:postgres": "node scripts/postgres-schema.mjs",
    "test": "tsx --test tests/*.test.ts",
    "test:api": "tsx scripts/verify-api.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "liquid-glass-react": "1.1.1",
    "lucide-react": "^0.468.0",
    "motion": "^14.4.0",
    "next": "16.4.2",
    "radix-ui": "^1.8.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.0.0",
    "tailwind-merge": "^3.0.0",
    "zod": "^4.0.0"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prisma": "6.19.3",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
