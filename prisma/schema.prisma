generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String @id @default(cuid())
  username     String @unique
  name         String
  passwordHash String
  revision     Int @default(0)
  createdAt    DateTime @default(now())
  sessions     Session[]
  plans        Plan[]
  tasks        Task[]
  focus        FocusSession[]
  agentRuns    AgentRun[]
  materials    StudyMaterial[]
  conversations AgentConversation[]
  observations LearningObservation[]
}

model Session {
  id        String @id @default(cuid())
  tokenHash String @unique
  userId    String
  expiresAt DateTime
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model Plan {
  id        String @id @default(cuid())
  userId    String
  title     String
  goal      String @default("")
  createdAt DateTime @default(now())
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks     Task[]
  @@index([userId])
}

model Task {
  id               String @id @default(cuid())
  userId           String
  planId           String?
  title            String
  subject          String @default("自主学习")
  scheduledDate    String
  estimatedMinutes Int @default(25)
  completed        Boolean @default(false)
  createdAt        DateTime @default(now())
  user             User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan             Plan? @relation(fields: [planId], references: [id], onDelete: SetNull)
  focus            FocusSession[]
  @@index([userId, scheduledDate])
}

model FocusSession {
  id             String @id @default(cuid())
  userId         String
  taskId         String?
  activeKey      String? @unique
  status         String @default("RUNNING")
  plannedSeconds Int
  elapsedSeconds Float @default(0)
  lastResumedAt  DateTime?
  startedAt      DateTime @default(now())
  endedAt        DateTime?
  segments       Json
  version        Int @default(0)
  user           User @relation(fields: [userId], references: [id], onDelete: Cascade)
  task           Task? @relation(fields: [taskId], references: [id], onDelete: SetNull)
  @@index([userId, startedAt])
}

model AgentRun {
  id               String @id @default(cuid())
  userId           String
  prompt           String
  status           String @default("PENDING")
  observedRevision Int
  analysis         String
  proposal         Json
  createdAt        DateTime @default(now())
  appliedAt        DateTime?
  user             User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
}

model StudyMaterial {
  id        String @id @default(cuid())
  userId    String
  title     String
  subject   String
  createdAt DateTime @default(now())
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  chunks    MaterialChunk[]
  @@index([userId, createdAt])
}

model MaterialChunk {
  id         String @id @default(cuid())
  materialId String
  position   Int
  locator    String
  text       String
  material   StudyMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
  @@unique([materialId, position])
}

model AgentConversation {
  id         String @id @default(cuid())
  userId     String
  title      String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  leaseId    String?
  leaseUntil DateTime?
  user       User @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages   AgentMessage[]
  observations LearningObservation[]
  @@index([userId, updatedAt])
}

model AgentMessage {
  id             String @id @default(cuid())
  conversationId String
  role           String
  content        String
  trace          Json @default("[]")
  createdAt      DateTime @default(now())
  conversation   AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  @@index([conversationId, createdAt])
}

model LearningObservation {
  id             String @id @default(cuid())
  userId         String
  conversationId String
  topic          String
  observation    String
  evidence       String
  createdAt      DateTime @default(now())
  user           User @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation   AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
}
